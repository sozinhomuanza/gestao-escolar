{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfig": {
      "providers": ["php"],
      "pkgs": ["php82", "php82Packages.composer", "php82Extensions.intl", "php82Extensions.mbstring", "php82Extensions.pdo_mysql"],
      "setup": {
        "commands": [
          "composer install --no-dev --optimize-autoloader"
        ]
      }
    }
  },
  "deploy": {
    "startCommand": "php -S 0.0.0.0:$PORT -t public public/index.php",
    "healthcheckPath": "/",
    "restartPolicy": "ON_FAILURE"
  }
}
