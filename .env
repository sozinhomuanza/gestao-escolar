#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# Deixamos em development para ver erros detalhados se algo falhar
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# CORREÇÃO: O endereço deve ser o que você usa no navegador
app.baseURL = 'http://localhost/projeto-escola/public/'

# Se preferir usar HTTPS no futuro, mude aqui, mas para XAMPP padrão é false
# app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# Removido o '#' do início para ativar as configurações
database.default.hostname = localhost
database.default.database = gestao_escolar
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix =

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# O CodeIgniter exige uma chave de criptografia para sessões/cookies. 
# Você pode gerar uma ou colocar uma frase aleatória longa aqui:
encryption.key = hex2bin:84f9715699478f70046e7f23c9135064
encryption.driver = OpenSSL